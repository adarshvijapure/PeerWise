# Required environment variables – copy this file to .env and fill in values

# Flask
SECRET_KEY=your-very-secret-key-change-this-in-production

# Google OAuth 2.0 (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Gmail SMTP (use an App Password, not your real password)
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=StudyGroup <your-sender@gmail.com>

# App public URL (update for production deployment)
APP_BASE_URL=http://localhost:5000

# Database (defaults to SQLite, override for Postgres in production)
# DATABASE_URL=postgresql://user:pass@localhost/studygroup

# Debug mode (1 = on, 0 = off)
FLASK_DEBUG=1
